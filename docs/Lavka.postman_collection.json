          "raw": "{\n  \"category_id\": \"{{category_id}}\",\n  \"slug\": \"shoes-black\",\n  \"name\": \"Чорні кросівки\",\n  \"attributes\": {\n    \"size\": 42\n  },\n  \"status\": \"active\"\n}",
