        "url": "{{base_url}}/api/v1/admin/promotion-rules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"10% на взуття\",\n  \"scope\": \"item\",\n  \"priority\": 100,\n  \"stop_processing\": false,\n  \"conditions\": {\n    \"all\": [\n      {\n        \"field\": \"item.category\",\n        \"op\": \"in\",\n        \"value\": [\n          \"shoes\"\n        ]\n      }\n    ]\n  },\n  \"actions\": [\n    {\n      \"type\": \"percent_discount\",\n      \"target\": \"item\",\n      \"value\": 10\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
