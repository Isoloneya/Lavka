{
  "info": {
    "name": "Lavka Engine — first milestone",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Створіть персонал через app:create-staff. Заповніть staff_email і staff_password. Запити створення зберігають UUID у змінні колекції."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "staff_email",
      "value": ""
    },
    {
      "key": "staff_password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "variant_id",
      "value": ""
    },
    {
      "key": "price_list_id",
      "value": ""
    },
    {
      "key": "warehouse_id",
      "value": ""
    },
    {
      "key": "rule_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST /api/v1/auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"password\": \"Secure-pass-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"user_id\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/v1/auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staff_email}}\",\n  \"password\": \"{{staff_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/v1/admin/categories",
