          "mode": "raw",
          "raw": "{\n  \"prices\": [\n    {\n      \"variant_id\": \"{{variant_id}}\",\n      \"amount_minor\": 100000,\n      \"min_quantity\": 1\n    },\n    {\n      \"variant_id\": \"{{variant_id}}\",\n      \"amount_minor\": 90000,\n      \"min_quantity\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
