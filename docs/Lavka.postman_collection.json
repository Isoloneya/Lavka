        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"shoes\",\n  \"name\": \"Взуття\",\n  \"attribute_schema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"size\": {\n        \"type\": \"integer\"\n      }\n    },\n    \"required\": [\n      \"size\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
