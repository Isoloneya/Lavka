{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "scope",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "scope": {
      "enum": [
        "item",
        "cart"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "stop_processing": {
      "type": "boolean"
    },
    "is_active": {
      "type": "boolean"
    },
    "coupon_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "op",
                  "value"
                ],
                "properties": {
                  "field": {
                    "const": "cart.subtotal"
                  },
                  "op": {
                    "const": ">="
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "op",
                  "value"
                ],
                "properties": {
                  "field": {
                    "const": "item.category"
                  },
                  "op": {
                    "const": "in"
                  },
                  "value": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target",
          "value"
        ],
        "properties": {
          "type": {
            "const": "percent_discount"
          },
          "target": {
            "enum": [
              "item",
              "cart"
            ]
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
