{
    frankenphp
    admin off
}

{$SERVER_NAME} {
    root * /app/public
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    request_body {
        max_size 1MB
    }
    php_server
}

:8081 {
    root * /app/public
    @health path /health
    handle @health {
        php_server
    }
    handle {
        respond 404
    }
}
