{
    frankenphp
    admin off
    auto_https off
}

:{$PORT:8080} {
    root * /app/public
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    request_body {
        max_size 1MB
    }
    php_server
}
