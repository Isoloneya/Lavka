<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\Domain\Product" table="product">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="categoryId" type="uuid" column="category_id"/>
        <field name="slug" type="string" column="slug" length="255" unique="true"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="description" type="text" column="description" nullable="true"/>
        <field name="attributes" type="json" column="attributes"/>
        <field name="status" type="string" column="status" length="20" enum-type="App\Catalog\Domain\ProductStatus"/>
        <indexes>
            <index columns="category_id"/>
            <index columns="status"/>
        </indexes>
    </entity>
</doctrine-mapping>
