<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\Domain\Category" table="category">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="parentId" type="uuid" column="parent_id" nullable="true"/>
        <field name="slug" type="string" column="slug" length="255" unique="true"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="attributeSchema" type="json" column="attribute_schema"/>
        <field name="isActive" type="boolean" column="is_active"/>
        <indexes>
            <index columns="parent_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
