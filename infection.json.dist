{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": { "directories": ["src/Pricing/Domain"] },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Pricing",
    "phpUnit": { "configDir": ".", "customPath": "vendor/bin/phpunit" },
