{% extends 'storefront/base.html.twig' %}
{% block title %}{{ register ? 'Реєстрація' : 'Вхід' }} — Lavka{% endblock %}
{% block content %}
<section class="auth-page"><h1>{{ register ? 'Створити обліковий запис' : 'З поверненням' }}</h1>
{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ path(register ? 'storefront_register' : 'storefront_login') }}" class="auth-form">
<input type="hidden" name="_token" value="{{ csrf }}">
<label>Email<input type="email" name="email" value="{{ email }}" maxlength="254" autocomplete="username" required></label>
<label>Пароль<input type="password" name="password" minlength="8" maxlength="72" autocomplete="{{ register ? 'new-password' : 'current-password' }}" required></label>
{% if register %}<p class="price-note">Від 8 символів, не більше 72 байтів. Підтвердження email у демо-версії не надсилається.</p>{% endif %}
<button class="button filled" type="submit">{{ register ? 'Зареєструватися' : 'Увійти' }}</button>
</form><a href="{{ path(register ? 'storefront_login' : 'storefront_register') }}">{{ register ? 'Уже є обліковий запис? Увійти' : 'Створити обліковий запис' }}</a></section>
{% endblock %}
