{% extends 'storefront/base.html.twig' %}
{% block body_class %}home{% endblock %}
{% block content %}
    <section class="campaign" aria-label="Осіння колекція">
        <video class="campaign-media" poster="{{ asset('storefront/media/campaign-generated.webp') }}" muted loop playsinline preload="none" {% if has_video %}data-campaign-video{% endif %}>
            {% if has_video %}<source src="{{ asset('storefront/media/' ~ video_file) }}" type="{{ video_type }}">{% endif %}
        </video>
        <div class="campaign-copy"><h1>ОСІНЬ / 2026</h1><a class="button light" href="{{ path('storefront_catalog') }}">Дивитися колекцію</a><a class="scroll-down" href="#collections" aria-label="Перейти до колекцій">↓</a></div>
        {% if has_video %}<button class="video-control" data-video-control hidden>Відтворити відео</button>{% endif %}
    </section>
    <section class="collections" id="collections" aria-label="Колекції Lavka">
        <article><div class="editorial-photo" role="img" aria-label="Осінній образ"></div><h2>Осінь 26</h2><a class="button" href="{{ path('storefront_catalog') }}">До колекції</a></article>
        <article><div class="editorial-photo second" role="img" aria-label="Міський образ"></div><h2>Свій ритм</h2><a class="button" href="{{ path('storefront_catalog') }}">Знайти своє</a></article>
    </section>
    <section class="new-arrivals"><div class="section-heading"><h2>Нові надходження</h2><a href="{{ path('storefront_catalog') }}">Усі товари ↗</a></div>{% include 'storefront/_products.html.twig' %}</section>
{% endblock %}
