{% extends 'storefront/base.html.twig' %}
{% block title %}Каталог — Lavka{% endblock %}
{% block content %}
<section class="catalog">
    <div class="section-heading"><h1>Усі речі</h1><span>{{ products.total }} товарів</span></div>
    <form class="filters" method="get" action="{{ path('storefront_catalog') }}">
        <label>Пошук<input id="search" type="search" name="q" value="{{ filters.q }}" maxlength="200" placeholder="Назва речі"></label>
        <label>Категорія<select name="category"><option value="">Усі категорії</option>{% for category in categories.items %}<option value="{{ category.slug }}" {% if filters.category == category.slug %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></label>
        <label>Сортування<select name="sort">{% for value, label in {'created_at': 'Спочатку нові', 'price': 'Від дешевих', '-price': 'Від дорогих', 'name': 'За назвою А–Я', '-name': 'За назвою Я–А'} %}<option value="{{ value }}" {% if filters.sort == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
        <button class="button" type="submit">Застосувати</button>
    </form>
    {% include 'storefront/_products.html.twig' %}
    <nav class="pagination" aria-label="Сторінки каталогу">
        {% if products.page > 1 %}<a class="button" rel="prev" href="{{ path('storefront_catalog', filters|merge({page: products.page - 1})) }}">← Назад</a>{% endif %}
        <span>Сторінка {{ products.page }}</span>
        {% if products.page * products.page_size < products.total %}<a class="button" rel="next" href="{{ path('storefront_catalog', filters|merge({page: products.page + 1})) }}">Далі →</a>{% endif %}
    </nav>
</section>
{% endblock %}
