{% extends 'storefront/base.html.twig' %}
{% block title %}Керування магазином — Lavka{% endblock %}
{% block content %}
<div class="staff-layout"><aside class="staff-menu"><h2>LAVKA / Керування</h2><a href="{{ path('staff_home') }}">Огляд</a><a href="{{ path('staff_orders') }}">Замовлення</a>{% for key, title in {'categories':'Категорії','products':'Товари','variants':'Варіанти SKU','lists':'Прайс-листи','prices':'Ціни','warehouses':'Склади','stock':'Залишки'} %}<a href="{{ path('staff_manage', {section:key}) }}">{{ title }}</a>{% endfor %}<a href="{{ path('staff_promotions') }}">Акції та купони</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('staff_users') }}">Користувачі</a><a href="{{ path('staff_groups') }}">Групи покупців</a><a href="{{ path('staff_audit') }}">Журнал аудиту</a>{% endif %}<a href="{{ path('storefront_account') }}">Мій кабінет</a></aside><section class="staff-main">{% block staff_content %}{% endblock %}</section></div>
{% endblock %}
