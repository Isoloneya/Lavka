{% extends 'staff/base.html.twig' %}
{% block staff_content %}<h1>Групи покупців</h1>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}<form method="post" class="staff-form"><input type="hidden" name="_token" value="{{ csrf }}"><label>Назва<input name="name" value="{{ values.name|default('') }}" required maxlength="255"></label><label>Унікальний код<input name="code" value="{{ values.code|default('') }}" required maxlength="64"></label><button class="button filled">Створити групу</button></form><div class="staff-table"><table><thead><tr><th>Назва</th><th>Код</th></tr></thead><tbody>{% for row in rows.items %}<tr><td>{{ row.name }}</td><td>{{ row.code }}</td></tr>{% else %}<tr><td colspan="2">Груп поки немає.</td></tr>{% endfor %}</tbody></table></div>{% include 'staff/_pagination.html.twig' with {route:'staff_groups',parameters:{}} %}{% endblock %}
