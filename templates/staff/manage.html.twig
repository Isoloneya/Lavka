{% extends 'staff/base.html.twig' %}
{% macro input(name, label, values, record, type='text', fallback='', required=true) %}<label>{{ label }}<input name="{{ name }}" type="{{ type }}" value="{{ attribute(values,name)|default(attribute(record|default({}),name)|default(fallback), true) }}" {% if required %}required{% endif %}></label>{% endmacro %}
{% macro select(name,label,items,values,record) %}<label>{{ label }}<select name="{{ name }}" required><option value="">Оберіть запис</option>{% for item in items %}<option value="{{ item.id }}" {% if attribute(values,name)|default(attribute(record|default({}),name)|default('')) == item.id %}selected{% endif %}>{{ item.name|default(item.sku|default(item.code|default(item.id))) }}</option>{% endfor %}</select></label>{% endmacro %}
{% macro json(name,label,values,record) %}<label class="wide">{{ label }}<textarea name="{{ name }}" rows="4" required>{{ attribute(values,name)|default(attribute(record|default({}),name)|default({})|json_encode(constant('JSON_FORCE_OBJECT'))) }}</textarea></label>{% endmacro %}
{% macro reference(id,items) %}{% for item in items %}{% if item.id == id %}{{ item.name|default(item.sku|default(item.code|default(item.id))) }}{% endif %}{% endfor %}{% endmacro %}
{% block staff_content %}
{% set titles = {'products':'Товари','categories':'Категорії','variants':'Варіанти SKU','warehouses':'Склади','stock':'Залишки','lists':'Прайс-листи','prices':'Ціни'} %}
<h1>{{ titles[section] }}</h1>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
<details class="staff-editor" {% if record or error or rows.total == 0 %}open{% endif %}><summary>{{ record ? 'Редагувати запис' : 'Додати / змінити' }}</summary>
<form method="post" class="staff-form"><input type="hidden" name="_token" value="{{ csrf }}">
{% if section in ['products','categories','warehouses'] %}{{ _self.input('name','Назва',values,record) }}{% endif %}
{% if section in ['products','categories'] %}{{ _self.input('slug','Адреса URL (slug)',values,record) }}{% endif %}
{% if section == 'products' %}
{{ _self.select('category_id','Категорія',choices.categories.items,values,record) }}
<label>Стан<select name="status">{% for key,label in {'draft':'Чернетка','active':'Активний'} %}<option value="{{ key }}" {% if values.status|default(record.status|default('draft')) == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label class="wide">Опис<textarea name="description" rows="4">{{ values.description|default(record.description|default('')) }}</textarea></label>{{ _self.json('attributes','Характеристики (JSON)',values,record) }}
{% elseif section == 'variants' %}{{ _self.select('product_id','Товар',choices.products.items,values,record) }}{{ _self.input('sku','SKU',values,record) }}{{ _self.json('options','Розмір, колір та інші опції (JSON)',values,record) }}
{% elseif section in ['warehouses','lists'] %}{{ _self.input('code','Унікальний код',values,record) }}{% if section == 'lists' %}{{ _self.input('priority','Пріоритет',values,record,'number',0) }}<p>Валюта: UAH. Прайс-лист для всіх покупців.</p>{% endif %}
{% elseif section == 'stock' %}{{ _self.select('variant_id','Варіант SKU',choices.variants.items,values,record) }}{{ _self.select('warehouse_id','Склад',choices.warehouses.items,values,record) }}{{ _self.input('delta','Зміна кількості (+ поповнення, − списання)',values,record,'number') }}
{% elseif section == 'prices' %}{{ _self.select('price_list_id','Прайс-лист',choices.lists.items,values,record) }}{{ _self.select('variant_id','Варіант SKU',choices.variants.items,values,record) }}{{ _self.input('amount_minor','Ціна у копійках (10000 = 100 грн)',values,record,'number') }}{{ _self.input('min_quantity','Від кількості',values,record,'number',1) }}
{% endif %}
{% if section in ['categories','variants'] %}<label>Доступність<select name="is_active"><option value="1" {% if values.is_active|default(record.is_active|default(true)) %}selected{% endif %}>Активний</option><option value="0" {% if not values.is_active|default(record.is_active|default(true)) %}selected{% endif %}>Неактивний</option></select></label>{% endif %}
<div class="wide staff-actions"><button class="button filled" type="submit">Зберегти</button>{% if record %}<a class="button" href="{{ path('staff_manage',{section:section}) }}">Закрити редактор</a>{% endif %}</div>
</form>{% if section == 'products' and record and is_granted('CATALOG_ARCHIVE') and record.status != 'archived' %}<form method="post" class="staff-actions"><input type="hidden" name="_token" value="{{ csrf }}"><button class="button" name="operation" value="archive">Архівувати товар</button></form>{% endif %}
</details>
<div class="staff-table"><table><thead><tr><th>Запис</th><th>Деталі</th><th>Дія</th></tr></thead><tbody>
{% for row in rows.items %}<tr><td>{% if section == 'stock' or section == 'prices' %}{{ _self.reference(row.variant_id,choices.variants.items) }}{% else %}{{ row.name|default(row.sku|default(row.code|default(row.id))) }}{% endif %}</td><td>
{% if section == 'products' %}{{ row.status }} / {{ row.slug }}
{% elseif section == 'categories' %}{{ row.is_active ? 'Активна' : 'Неактивна' }} / {{ row.slug }}
{% elseif section == 'variants' %}{{ _self.reference(row.product_id,choices.products.items) }} / {{ row.is_active ? 'Активний' : 'Неактивний' }}
{% elseif section == 'stock' %}{{ _self.reference(row.warehouse_id,choices.warehouses.items) }}: {{ row.quantity }} / резерв {{ row.reserved }} / доступно {{ row.quantity - row.reserved }}
{% elseif section == 'prices' %}{{ _self.reference(row.price_list_id,choices.lists.items) }}: {{ (row.amount_minor/100)|number_format(2, ',', ' ') }} / від {{ row.min_quantity }} шт.
{% elseif section == 'lists' %}{{ row.currency }} / пріоритет {{ row.priority }}
{% else %}{{ row.code }}{% endif %}</td><td>{% if section in ['products','categories','variants'] %}<a href="{{ path('staff_manage',{section:section,edit:row.id}) }}">Редагувати ↗</a>{% endif %}</td></tr>
{% else %}<tr><td colspan="3">Записів ще немає. Скористайтеся формою вище.</td></tr>{% endfor %}</tbody></table></div>
{% include 'staff/_pagination.html.twig' with {route:'staff_manage',parameters:{section:section}} %}
{% endblock %}
