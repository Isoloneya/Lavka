{% extends 'staff/base.html.twig' %}
{% block staff_content %}<h1>Користувачі</h1>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}<p>Роль визначає доступ до магазину й адмінки. Група визначає доступні персональні прайс-листи.</p><div class="user-list">{% for user in rows.items %}<form method="post" class="staff-form user-editor"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="id" value="{{ user.id }}"><h2 class="wide">{{ user.email }}</h2><label>Роль<select name="role">{% for key,label in {'ROLE_CUSTOMER':'Покупець','ROLE_MANAGER':'Менеджер','ROLE_ADMIN':'Адміністратор'} %}<option value="{{ key }}" {% if key in user.roles %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label>Група<select name="customer_group"><option value="">Без групи</option>{% for group in groups %}<option value="{{ group.code }}" {% if user.customer_group == group.code %}selected{% endif %}>{{ group.name }} / {{ group.code }}</option>{% endfor %}</select></label><button class="button" type="submit">Зберегти користувача</button></form>{% else %}<p>Користувачів немає.</p>{% endfor %}</div>{% include 'staff/_pagination.html.twig' with {route:'staff_users',parameters:{}} %}{% endblock %}
