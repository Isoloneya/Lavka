{% extends 'staff/base.html.twig' %}
{% block staff_content %}<h1>Замовлення</h1><div class="staff-table"><table><thead><tr><th>Номер</th><th>Покупець</th><th>Стан</th><th>Разом</th></tr></thead><tbody>{% for order in rows.items %}<tr><td><a href="{{ path('staff_order',{number:order.number}) }}">{{ order.number }} ↗</a></td><td>{{ order.email }}</td><td>{{ order.status }}</td><td>{{ (order.total_minor / 100)|number_format(2, ',', ' ') }} ₴</td></tr>{% else %}<tr><td colspan="4">Замовлень ще немає.</td></tr>{% endfor %}</tbody></table></div>{% include 'staff/_pagination.html.twig' with {route:'staff_orders', parameters:{}} %}{% endblock %}
