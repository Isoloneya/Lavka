{% extends 'staff/base.html.twig' %}
{% block staff_content %}<h1>Журнал аудиту</h1><p>Журнал доступний лише для перегляду.</p><div class="staff-table"><table><thead><tr><th>Час (Київ)</th><th>Працівник (ID)</th><th>Дія / ресурс</th><th>Зміни</th></tr></thead><tbody>{% for row in rows.items %}<tr><td>{{ row.created_at|date('d.m.Y H:i:s','Europe/Kyiv') }}</td><td>{{ row.actor_id }}</td><td>{{ row.action }} {{ row.resource }}</td><td><details><summary>Переглянути</summary><pre class="audit-json">{{ row.changes|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></details></td></tr>{% else %}<tr><td colspan="4">Записів поки немає.</td></tr>{% endfor %}</tbody></table></div>{% include 'staff/_pagination.html.twig' with {route:'staff_audit',parameters:{}} %}{% endblock %}
